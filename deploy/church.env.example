# ─────────────────────────────────────────────────────────────────────────────
# Settings for ONE church. bin/add-church creates churches/<slug>/church.env
# from this file and fills in the generated secrets. Never commit real files.
# ─────────────────────────────────────────────────────────────────────────────

# ── Web address ──────────────────────────────────────────────────────────────
# Domain this church's app is served on (DNS A record → this server).
CHURCH_DOMAIN=grace.example.org
APP_URL=https://grace.example.org

# ── Church identity (shown in the app, emails, SMS and WhatsApp) ─────────────
CHURCH_NAME=Grace Chapel Ikeja
CHURCH_SHORT_NAME=Grace Chapel
# Line above the logo on the sign-in page; leave empty to hide.
CHURCH_DENOMINATION=
CHURCH_MINISTRY_NAME=Children's Church
CHURCH_LOCALITY=Ikeja
CHURCH_ADDRESS=12 Example Road, Ikeja, Lagos
CHURCH_MAPS_URL=
CHURCH_TAGLINE=Safe. Known. Celebrated.
CHURCH_BRAND_COLOR=#1e3a8a
# Put the logo at churches/<slug>/branding/logo.png
CHURCH_LOGO_URL=/branding/logo.png
# Absolute URL for emails (email apps cannot load relative paths).
CHURCH_EMAIL_LOGO_URL=https://grace.example.org/branding/logo.png

# ── Sunday services (church local time, 24h) ─────────────────────────────────
SERVICE_1_START=07:00
SERVICE_1_LABEL=1st Service
SERVICE_1_TIME_TEXT=7:00 – 10:00 AM
SERVICE_1_MESSAGE_NAME=First Service
SERVICE_2_START=10:30
SERVICE_2_LABEL=2nd Service
SERVICE_2_TIME_TEXT=10:30 AM onwards
SERVICE_2_MESSAGE_NAME=Second Service

# ── Secrets (generated by bin/add-church — keep private) ─────────────────────
SESSION_SECRET=
DATABASE_URL=

# ── File storage: one S3-compatible bucket per church ───────────────────────
STORAGE_DRIVER=s3
# e.g. https://ACCOUNT_ID.r2.cloudflarestorage.com (Cloudflare R2)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PRIVATE_OBJECT_DIR=/grace-shepherd/private
PUBLIC_OBJECT_SEARCH_PATHS=/grace-shepherd/public

# ── Messaging ────────────────────────────────────────────────────────────────
# SMS (Termii). Register the church's own sender ID with Termii, or keep N-Alert.
TERMII_API_KEY=
TERMII_SENDER_ID=N-Alert
# Email (Resend). The sending domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Grace Chapel <noreply@grace.example.org>
# Web push notifications (generated by bin/add-church).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@grace.example.org

# ── WhatsApp assistant AI (your own OpenAI key) ──────────────────────────────
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# Bible readings on classroom displays (API.Bible)
API_BIBLE_KEY=
# Twilio fallbacks (leave empty if unused)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
