# Server-wide settings for deploy/docker-compose.yml. Copy to deploy/.env.
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=ops@intelyticslimited.com
# Postgres superuser password (generate with: openssl rand -hex 24)
POSTGRES_PASSWORD=
# Image tag to run (bin/update sets this to the deployed git commit).
RELEASE=latest
# Offsite backups (any S3-compatible bucket, separate from church files).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_KEEP_DAYS=30
